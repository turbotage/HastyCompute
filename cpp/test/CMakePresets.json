{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 1
    },
    "include": ["../../CommonPresets.json"],
    "configurePresets": [
        {
            "name": "MainConfigClang-Linux",
            "inherits": ["CommonClangSettings"],
            "binaryDir": "${sourceDir}/../../out/build/test-${presetName}",
            "environment": {
                "CUDA_ROOT": "/usr/local/cuda-13.0"
            },
            "cacheVariables": {
                "CMAKE_CUDA_COMPILER": "$env{CUDA_ROOT}/bin/nvcc",
                "CUDAToolkit_ROOT": "$env{CUDA_ROOT}"
            }
        },
        {
            "name": "HastyComputeTest-ClangRelWithDebInfo-Linux",
            "displayName": "HastyComputeTest-ClangRelWithDebInfo-Linux",
            "inherits": ["MainConfigClang-Linux"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "HastyComputeTest-ClangDebug-Linux",
            "displayName": "HastyComputeTest-ClangDebug-Linux",
            "inherits": ["MainConfigClang-Linux"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}
