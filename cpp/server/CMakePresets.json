{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "include": ["../../CommonPresets.json"],
    "configurePresets": [
        {
            "name": "MainConfigClang-Linux",
            "inherits": ["CommonClangSettings"],
            "binaryDir": "${sourceDir}/../../out/build/lib-${presetName}",
            "environment": {
            },
            "cacheVariables": {
            }
        },
        {
            "name": "HastyComputeServer-ClangRelWithDebInfo-Linux",
            "displayName": "HastyComputeServer-ClangRelWithDebInfo-Linux",
            "inherits": ["MainConfigClang-Linux"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "HastyComputeServer-ClangDebug-Linux",
            "displayName": "HastyComputeServer-ClangDebug-Linux",
            "inherits": ["MainConfigClang-Linux"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }

    ]
}