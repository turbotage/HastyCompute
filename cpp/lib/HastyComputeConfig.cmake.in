@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads REQUIRED)
find_dependency(CUDAToolkit REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/HastyComputeTargets.cmake")

# Torch shared libraries — installed alongside libHastyCompute.so
foreach(_dep torch_cpu torch_cuda torch c10 c10_cuda)
    find_library(_dep_path ${_dep}
        PATHS "${PACKAGE_PREFIX_DIR}/lib"
        NO_DEFAULT_PATH
    )
    if(_dep_path)
        set_property(TARGET HastyCompute::HastyCompute APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES "${_dep_path}")
    endif()
    unset(_dep_path CACHE)
endforeach()

foreach(_dep cufinufft finufft)
    find_library(_dep_path ${_dep}
        PATHS "${PACKAGE_PREFIX_DIR}/lib" NO_DEFAULT_PATH)
    if(_dep_path)
        set_property(TARGET HastyCompute::HastyCompute APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES "${_dep_path}")
    endif()
    unset(_dep_path CACHE)
endforeach()

foreach(_dep cudart cufft)
    find_library(_dep_path ${_dep}
        PATHS "${CUDAToolkit_LIBRARY_DIR}" NO_DEFAULT_PATH)
    if(_dep_path)
        set_property(TARGET HastyCompute::HastyCompute APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES "${_dep_path}")
    endif()
    unset(_dep_path CACHE)
endforeach()
