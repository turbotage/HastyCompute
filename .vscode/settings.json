{
    "latex-workshop.hover.preview.enabled": true,
    "mathover.matchRegex": "\\\\f\\[(.*?)\\\\f\\]",
    "mathover.forwardSkip": 3,
    "mathover.backwardSkip": 3,
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python-envs.defaultPackageManager": "ms-python.python:pip",
    "python.defaultInterpreterPath": "${workspaceFolder}/rustlib/.venv/bin/python",
    "python.analysis.extraPaths": ["${workspaceFolder}/python/lib"],
    "remote.portsAttributes": {
        "0-65535": {
            "onAutoForward": "notify"
        }
    },
    "workbench.externalUriOpeners": {
        "https://*": "default",
        "http://*": "default",
        "https://localhost:*": "default",
        "http://localhost:*": "default",
        "https://127.0.0.1:*": "default",
        "http://127.0.0.1:*": "default"
    },
    "remote.forwardOnOpen": false,
    "workbench.browser.openLocalhostLinks": false
}
