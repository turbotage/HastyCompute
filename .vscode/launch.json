{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python C++ Debugger",
            "type": "pythoncpp",
            "request": "launch",
            "pythonLaunchName": "Python Debugger: Current File",
            "cppAttachName": "(lldb-dap) Attach HastyCuCompute",
            "justMyCode": false
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python Debugger: Current File as Module",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/python/_run_module.py",
            "args": ["${file}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "(lldb-dap) HastyTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/test-build/HastyTest",
            "args": [],
            "stopOnEntry": false,
        },
        {
            "name": "(lldb-dap) HastyLinalgTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/test-build/HastyLinalgTest",
            "args": [],
            "stopOnEntry": false,
        },
        {
            "name": "(lldb-dap) HastyDataTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/test-build/HastyDataTest",
            "args": [],
            "stopOnEntry": false,
        },
        {
            "name": "(lldb-dap) HastyVkFFTTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/test-build/HastyVkFFTTest",
            "args": [],
            "stopOnEntry": false,
        },
        {
            "name": "(lldb-dap) Attach HastyCompute",
            "type": "lldb-dap",
            "request": "attach",
        },
    ]
}