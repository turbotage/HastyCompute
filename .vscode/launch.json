{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python C++ Debugger",
            "type": "pythoncpp",
            "request": "launch",
            "pythonLaunchName": "Python Debugger: Current File",
            "cppAttachName": "(lldb-dap) Attach HastyCuCompute",
            "justMyCode": false
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python Debugger: Current File as Module",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/python/_run_module.py",
            "args": ["${file}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "(lldb-dap) HastyTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/test-build/HastyTest",
            "args": [],
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "env": { "LD_LIBRARY_PATH": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/install/lib" }
        },
        {
            "name": "(lldb-dap) HastyServerTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/test-build/HastyServerTest",
            "args": [],
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "env": { "LD_LIBRARY_PATH": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/install/lib" }
        },
        {
            "name": "(lldb-dap) HastyLinalgTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/test-build/HastyLinalgTest",
            "args": [],
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "env": { "LD_LIBRARY_PATH": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/install/lib" }
        },
        {
            "name": "(lldb-dap) HastyDataTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/test-build/HastyDataTest",
            "args": [],
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "env": { "LD_LIBRARY_PATH": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/install/lib" }
        },
        {
            "name": "(lldb-dap) HastyNonFourierInterpTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/test-build/HastyNonFourierInterpTest",
            "args": [],
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "env": { "LD_LIBRARY_PATH": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/install/lib" }
        },
        {
            // Start this ONCE before running the C++ program.
            // VS Code listens on port 5678; each Python subprocess auto-connects
            // when run_script(..., debug=true) is used. No manual attach needed.
            // Breakpoints set on workspace source files work directly because
            // scripts run from HASTY_SCRIPTS_DIR (source tree) and hastycompute
            // is installed editable so debugpy sees real workspace paths.
            "name": "Python: Listen for subprocess (debugpy)",
            "type": "debugpy",
            "request": "attach",
            "listen": { "host": "localhost", "port": 5678 },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/python",
                    "remoteRoot": "${workspaceFolder}/python"
                }
            ],
            "justMyCode": false,
        },
        {
            "name": "(lldb-dap) HastyVkFFTTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/test-build/HastyVkFFTTest",
            "args": [],
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "env": { "LD_LIBRARY_PATH": "${workspaceFolder}/out/build/Config-ClangDebug-Linux/install/lib" }
        },
        {
            "name": "(lldb-dap) Attach HastyCompute",
            "type": "lldb-dap",
            "request": "attach",
            "console": "integratedTerminal",
        },
    ]
}