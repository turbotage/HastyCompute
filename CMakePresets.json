{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 1
    },
    "include": [
    ],
    "configurePresets": [
        {
            "name": "MainConfigClang",
            "hidden": true,
            "inherits": []
        },
        {
            "name": "BaseDebug",
            "hidden": true,
            "inherits": ["MainConfigClang"],
            "binaryDir": "${sourceDir}/out/build/Config-ClangDebug-Linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "BaseRelWithDebInfo",
            "hidden": true,
            "inherits": ["MainConfigClang"],
            "binaryDir": "${sourceDir}/out/build/Config-ClangRelWithDebInfo-Linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "Config-ClangDebug-Linux-Full",
            "displayName": "Config-ClangDebug-Linux-Full",
            "inherits": ["BaseDebug"],
            "cacheVariables": {
                "HASTY_BUILD_TARGETS": "lib;server;test"
            }
        },
        {
            "name": "Config-ClangDebug-Linux-Lib",
            "displayName": "Config-ClangDebug-Linux-Lib",
            "inherits": ["BaseDebug"],
            "cacheVariables": {
                "HASTY_BUILD_TARGETS": "lib"
            }
        },
        {
            "name": "Config-ClangDebug-Linux-Server",
            "displayName": "Config-ClangDebug-Linux-Server",
            "inherits": ["BaseDebug"],
            "cacheVariables": {
                "HASTY_BUILD_TARGETS": "lib;server"
            }
        },
        {
            "name": "Config-ClangDebug-Linux-Test",
            "displayName": "Config-ClangDebug-Linux-Test",
            "inherits": ["BaseDebug"],
            "cacheVariables": {
                "HASTY_BUILD_TARGETS": "lib;test"
            }
        },
        {
            "name": "Config-ClangRelWithDebInfo-Linux-Full",
            "displayName": "Config-ClangRelWithDebInfo-Linux-Full",
            "inherits": ["BaseRelWithDebInfo"],
            "cacheVariables": {
                "HASTY_BUILD_TARGETS": "lib;server;test"
            }
        },
        {
            "name": "Config-ClangRelWithDebInfo-Linux-Lib",
            "displayName": "Config-ClangRelWithDebInfo-Linux-Lib",
            "inherits": ["BaseRelWithDebInfo"],
            "cacheVariables": {
                "HASTY_BUILD_TARGETS": "lib"
            }
        },
        {
            "name": "Config-ClangRelWithDebInfo-Linux-Server",
            "displayName": "Config-ClangRelWithDebInfo-Linux-Server",
            "inherits": ["BaseRelWithDebInfo"],
            "cacheVariables": {
                "HASTY_BUILD_TARGETS": "lib;server"
            }
        },
        {
            "name": "Config-ClangRelWithDebInfo-Linux-Test",
            "displayName": "Config-ClangRelWithDebInfo-Linux-Test",
            "inherits": ["BaseRelWithDebInfo"],
            "cacheVariables": {
                "HASTY_BUILD_TARGETS": "lib;test"
            }
        }
    ]
